# ----------------------------------------------------------------------
# Настройки Apache-хостинга для GLAIRE
# ----------------------------------------------------------------------
# GitHub Pages этот файл не использует, но на SpaceWeb и похожем Apache-хостинге
# он помогает держать сайт быстрым и безопасным: HTTPS, кеш, сжатие и заголовки.

# Не даём серверу показывать список файлов папки, если случайно нет index.html.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let’s Encrypt должен читать проверочный файл по HTTP без перенаправления.
  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # Убираем дубли /index.html и /услуга/index.html только при прямом запросе.
  RewriteCond %{HTTP_HOST} ^(www\.)?glaire\.ru$ [NC]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*\/)?index\.html$ https://glaire.ru/$1 [R=301,L]

  # Переводим на HTTPS только основной домен.
  # Технический адрес SpaceWeb остаётся доступен по HTTP для проверки до DNS.
  RewriteCond %{HTTP_HOST} ^(www\.)?glaire\.ru$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://glaire.ru%{REQUEST_URI} [R=301,L]

  # Если открыли www.glaire.ru, аккуратно переводим на основной домен glaire.ru.
  RewriteCond %{HTTP_HOST} ^www\.glaire\.ru$ [NC]
  RewriteRule ^ https://glaire.ru%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  # Сжимаем текстовые файлы: HTML, CSS, JS, XML, JSON и SVG.
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  # Явно говорим старым Apache-хостингам, что WebP — это изображение.
  AddType image/webp .webp
  AddType audio/mp4 .m4a
</IfModule>

# ETag часто заставляет браузер лишний раз перепроверять статические файлы.
# Для лендинга с версионируемыми загрузками надёжнее управлять кешем через Cache-Control.
FileETag None

<IfModule mod_brotli.c>
  # Если на хостинге включён Brotli, он сожмёт текст ещё лучше, чем gzip.
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Базовые безопасные заголовки, которые не ломают внешний вид и JS сайта.
  Header set X-Content-Type-Options "nosniff"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'nonce-glaire-static'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://res.cloudinary.com https://yandex.com https://yastatic.net https://*.yastatic.net https://*.yandex.ru https://*.yandex.net; font-src 'self'; media-src 'self' https://res.cloudinary.com; frame-src https://yandex.com https://yandex.ru https://*.yandex.ru; connect-src 'self' https://res.cloudinary.com https://yandex.com https://yastatic.net https://*.yastatic.net https://*.yandex.ru https://*.yandex.net https://mc.yandex.ru; manifest-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header append Vary "Accept-Encoding"

  # Не отправляем ETag, чтобы браузер увереннее использовал долгий кеш статики.
  Header unset ETag

  # HTML должен обновляться быстро после правок.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Статические ресурсы можно хранить дольше: это помогает PageSpeed и браузерам.
  <FilesMatch "\.(woff2|png|jpg|jpeg|webp|gif|svg|ico|m4a)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Код и служебные документы перепроверяются, чтобы обновления не застревали на год.
  <FilesMatch "\.(css|js|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  # Дублируем политику кеширования через Expires для старых связок Apache/CDN.
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 hour"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType audio/mp4 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
